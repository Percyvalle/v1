# Токен для чат-бота — получить на https://twitchtokengenerator.com/
# (выбрать Bot Chat Token, разрешения: chat:read chat:edit)
TWITCH_BOT_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Имя аккаунта бота (можно использовать свой основной аккаунт, если отдельный не нужен)
TWITCH_BOT_NICK=имя_бота

# Канал, в чате которого бот будет работать (твой ник на Twitch, без #)
TWITCH_CHANNEL=твой_канал

# Ключ DeepSeek API — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Как бот будет обращаться к себе в чате, чтобы люди могли его позвать
BOT_TRIGGER=бот

# Триггеры для голоса — отдельно, потому что распознавание речи коверкает имя
# (пиши корни без окончаний, сравнение нестрогое). Пусто — берутся из BOT_TRIGGER
VOICE_TRIGGER=

# true — на голос бот отвечает ТОЛЬКО когда услышал своё имя.
# false — без имени тоже иногда вставляет реплику (не чаще раза в 35 сек),
# а по имени отвечает всегда и мгновенно
VOICE_REQUIRE_TRIGGER=false

# Включить голосовой ввод с микрофона (true/false). Требует faster-whisper,
# при первом запуске скачает модель распознавания речи локально (~500 МБ),
# дальше работает офлайн и бесплатно
VOICE_ENABLED=false

# Как называть тебя (стримера) в памяти бота при голосовом общении
STREAMER_NAME=стример

# Личность бота — как он должен себя вести и разговаривать
BOT_PERSONALITY=Ты — дерзкий, но добрый чат-бот стримера. Отвечай коротко (1-2 предложения), с юмором, используй сленг Twitch-чата. Никогда не пиши длинных сообщений.

# Анти-бот модерация — отдельный проект ../Cigilbot (своя БД, своя панель,
# свой процесс). Этот флаг решает только одно: писать ли main.py каждое
# сообщение чата в очередь mod_inbox для Cigilbot — сама модерация,
# её настройки и панель управления описаны в README/.env Cigilbot.
MODERATION_ENABLED=true

# --- Вход в панель управления ботами через Twitch (panel/auth.py) ---------
# Отдельное Twitch-приложение (НЕ то же самое, что TWITCH_BOT_TOKEN) —
# зарегистрировать на https://dev.twitch.tv/console/apps:
#   OAuth Redirect URL: http://localhost:8765/auth/callback
#   Client Type: Confidential
# Роль в панели определяется автоматически: сам канал (broadcaster) — OWNER,
# модераторы канала (Helix GET /moderation/moderators) — MODERATOR, все
# остальные вошедшие — VIEWER. Ручной выдачи роли ADMIN нет в этом .env —
# назначается через таблицу panel_admins (bot/database.py) существующим
# ADMIN/OWNER.
PANEL_TWITCH_CLIENT_ID=
PANEL_TWITCH_CLIENT_SECRET=
# Канал, чьих модераторов панель считает авторизованными — обычно тот же,
# что TWITCH_CHANNEL основного профиля бота.
PANEL_TWITCH_CHANNEL=твой_канал

# Секрет для подписи cookie-сессий панели (случайная строка, держать в
# тайне — компрометация даёт возможность подделать любую сессию/роль).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
PANEL_SESSION_SECRET=
