# Cigilbot — панель модерации + движок анти-спам детекции. Отдельный
# процесс от TWITCH BOTS, своя БД (mod.<profile>.db), свой порт (8766).
#
# BOT_PROJECT_ROOT — путь к соседнему проекту TWITCH BOTS, где живёт
# bot.<instance>.db (история чата, читается через mod_inbox) — нужен
# только consumer.py, переопределить, если TWITCH BOTS не лежит рядом.
# По умолчанию: ../TWITCH BOTS относительно этой папки.
BOT_PROJECT_ROOT=

# --- Вход в панель модерации через Twitch (panel/auth.py) ------------------
# Отдельное Twitch-приложение (НЕ то же самое, что TWITCH_BOT_TOKEN бота) —
# зарегистрировать на https://dev.twitch.tv/console/apps:
#   OAuth Redirect URL: http://localhost:8766/auth/callback
#   Client Type: Confidential
# Роль в панели определяется автоматически: сам канал (broadcaster) — OWNER,
# модераторы канала (Helix GET /moderation/moderators) — MODERATOR, все
# остальные вошедшие — VIEWER. Ручной выдачи роли для ADMIN нет — только
# через существующий OWNER/ADMIN на экране Panel Users.
PANEL_TWITCH_CLIENT_ID=
PANEL_TWITCH_CLIENT_SECRET=
# Канал, чьих модераторов панель считает авторизованными.
PANEL_TWITCH_CHANNEL=твой_канал

# Секрет для подписи cookie-сессий панели (случайная строка, держать в
# тайне — компрометация даёт возможность подделать любую сессию/роль).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
PANEL_SESSION_SECRET=

# --- Токен бота для реальных банов/таймаутов (executor.py) -----------------
# Заполняются АВТОМАТИЧЕСКИ кнопкой "Получить токен бота" на экране Settings
# панели (роль ADMIN+) — руками сюда обычно ничего вписывать не нужно.
# Тот, кто проходит вход, должен сделать это будучи залогиненным на Twitch
# ПОД АККАУНТОМ БОТА (не под своим личным) — иначе moderator_id токена не
# совпадёт с аккаунтом бота, и все баны будут падать с 401. Аккаунт бота
# также должен быть модератором канала (команда /mod <бот> в чате).
# Требует те же PANEL_TWITCH_CLIENT_ID/SECRET, что вход в панель выше.
TWITCH_MOD_ACCESS_TOKEN=
TWITCH_MOD_REFRESH_TOKEN=
TWITCH_MOD_BOT_LOGIN=
TWITCH_MOD_BOT_USER_ID=
TWITCH_MOD_BROADCASTER_ID=
