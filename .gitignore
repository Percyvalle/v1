# Виртуальные окружения — у каждого проекта своё, и это осознанно:
# apps/twitch-bots тянет twitchio/faster-whisper/numpy, apps/cigilbot —
# lingua/PyYAML. Одно общее окружение связало бы два процесса, которые
# специально сделаны независимыми (падение одного не роняет другой).
.venv/

# Секреты. Правило-исключение покрывает и .env.example, и .env.<что-то>.example —
# без второй строки любой пример с суффиксом остался бы невидимым для git.
.env
.env.*
!.env.example
!.env.*.example

# Состояние выполнения: живые БД, pid/lock-файлы запущенных процессов, логи.
# БД не версионируются намеренно — это рабочие данные каналов, не код.
*.db
*.db-shm
*.db-wal
*.pid
*.lock
logs/

# Локальное межпроцессное состояние (bot/voice_queue.py передаёт распознанный
# текст между main.py и voice_main.py через файл) и счётчики расхода API.
voice_input*.txt
usage*.json
# Паттерн со слешем внутри привязан к папке с .gitignore, поэтому ведущий **/.
# Каталог сменился с panel/ на panel_state/: панель переехала в apps/panel, а
# её рабочие файлы остались рядом с ботом, чей .env они и описывают.
**/panel_state/

# Архив остатков старой per-channel модели — держим на диске как данные для
# калибровки порогов, но под git им делать нечего.
_archive/

# Кеши инструментов и сгенерированное
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
graphify-out/

# Локальные настройки редактора/агента
.claude/settings.local.json
